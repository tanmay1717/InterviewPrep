# Copy this file to .env and fill in real values. Never put real values in this file - it is committed to git.
# Neon > your project > Connect > copy the connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
